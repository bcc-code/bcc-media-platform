enum MessageStyleVariant {
    info
    warning
    error
}

type MessageStyle {
    text: String!
    background: String!
    border: String!
}

type Message {
    title: String!
    content: String!
    variant: MessageStyleVariant!
    style: MessageStyle! @deprecated(reason: "Replaced by the variant field. Colors belong in each app's design system, so they can follow dark/light mode.")
}
