directive @goField(forceResolver: Boolean, name: String) on INPUT_FIELD_DEFINITION
    | FIELD_DEFINITION

"Requires the caller to hold `level` (write implies read) on `resource`. Every root field except `auth` must declare it or @superuser."
directive @access(resource: AdminResource!, level: AccessLevel!) on FIELD_DEFINITION

directive @superuser on FIELD_DEFINITION

enum AdminResource {
    search
    preview
    statistics
    episodes
    mediaItems
    episodeAccess
}

enum AccessLevel {
    read
    write
}

type Preview {
    collection(filter: String!): PreviewCollection! @goField(forceResolver: true)
    asset(id: ID!): PreviewAsset! @goField(forceResolver: true)
}

type PreviewCollection {
    items: [CollectionItem!]!
}

type PreviewAsset {
    url: String!
    type: String!
}

enum Collection {
    shows,
    seasons,
    episodes,
    games,
    shorts,
}

type CollectionItem {
    collection: Collection!
    id: ID!
    title: String!
}

type ProgressByOrg {
    name: String!
    progress: Float!
}

type Statistics {
    lessonProgressGroupedByOrg(
        lessonID: ID!,
        ageGroups: [String!]!,
        orgMaxSize: Int,
        orgMinSize: Int,
    ): [ProgressByOrg!]! @goField(forceResolver: true)
}

type Episodes {
    importTimedMetadata(episodeId: ID!): Boolean! @goField(forceResolver: true) @access(resource: episodes, level: write)
}

type MediaItems {
    importTimedMetadata(mediaItemId: ID!): Boolean! @goField(forceResolver: true) @access(resource: mediaItems, level: write)
}

type AdminUser {
    id: ID!
    email: String!
    firstName: String
    lastName: String
    avatarUrl: String
    "Full access, including access management. UI hint only; the API enforces access itself."
    superuser: Boolean!
}

type AuthResult {
    accessToken: String!
    expiresInMs: Int!
    user: AdminUser!
}

# Session management for admin-web. Login is proxied to Directus server-side;
# the API mints its own access token and keeps the refresh token in an
# httpOnly cookie. These are the only operations that execute without
# credentials (see the auth extension in auth.go).
type Auth {
    login(email: String!, password: String!, otp: String): AuthResult! @goField(forceResolver: true)
    refresh: AuthResult! @goField(forceResolver: true)
    logout: Boolean! @goField(forceResolver: true)
}

enum SearchType {
    episode,
    season,
    show,
}

input SearchFilter {
    "Defaults to all types."
    types: [SearchType!]
}

union SearchItem = Episode | Season | Show

type SearchHit {
    id: ID!
    type: SearchType!
    score: Float
    "Null if the item was deleted after it was indexed."
    item: SearchItem @goField(forceResolver: true)
    "Absolute link to the item in the web app. Seasons link to their show. Null if the item was deleted after it was indexed."
    url: String @goField(forceResolver: true)
    "Absolute link to the embeddable player. Episodes only; null for seasons and shows."
    embedUrl: String @goField(forceResolver: true)
}

type SearchResult {
    total: Int!
    "The usergroup set by the caller's search scope, if any."
    group: String
    hits: [SearchHit!]!
}

type Search {
    query(query: String!, filter: SearchFilter, first: Int, offset: Int): SearchResult! @goField(forceResolver: true)
}

type Availability {
    published: Boolean!
    unlisted: Boolean!
    "RFC3339"
    from: String
    to: String
    publishedOn: String
}

type Roles {
    access: [String!]!
    download: [String!]!
    earlyAccess: [String!]!
}

# Episode, Season, Show, Image and Status are bound to the main API's Go models (see gqlgen.yml).
# Keep field names and types in sync with graph/api/schema.

enum Status {
    published
    unlisted
    draft
    archived
}

type Image {
    style: String!
    url: String!
}

type Episode {
    id: ID!
    uuid: String!
    status: Status! @goField(forceResolver: true)
    title: String!
    description: String!
    ageRating: String!
    duration: Int!
    number: Int
    imageUrl: String
    images: [Image!]!
    season: Season @goField(forceResolver: true)
    availability: Availability! @goField(forceResolver: true)
    roles: Roles! @goField(forceResolver: true)
}

type Season {
    id: ID!
    status: Status! @goField(forceResolver: true)
    title: String!
    description: String!
    ageRating: String!
    number: Int!
    imageUrl: String
    images: [Image!]!
    show: Show! @goField(forceResolver: true)
    availability: Availability! @goField(forceResolver: true)
    roles: Roles! @goField(forceResolver: true)
}

type Show {
    id: ID!
    status: Status! @goField(forceResolver: true)
    title: String!
    description: String!
    imageUrl: String
    images: [Image!]!
    availability: Availability! @goField(forceResolver: true)
    roles: Roles! @goField(forceResolver: true)
}

"Limits on a grant, keyed by resource. Only the field matching the grant's resource may be set."
input PermissionScopeInput {
    search: SearchScopeInput
    episodeAccess: EpisodeAccessScopeInput
}

input SearchScopeInput {
    "Search as a member of this usergroup: only published, currently available items it can access."
    group: String
    types: [SearchType!]
}

input EpisodeAccessScopeInput {
    "Group codes the grant may grant or revoke. Null means any group."
    groups: [ID!]
}

type SearchScope {
    group: String
    types: [SearchType!]
}

type EpisodeAccessScope {
    groups: [ID!]
}

type PermissionScope {
    search: SearchScope
    episodeAccess: EpisodeAccessScope
}

input PermissionInput {
    resource: AdminResource!
    level: AccessLevel!
    scope: PermissionScopeInput
}

type Permission {
    resource: AdminResource!
    level: AccessLevel!
    scope: PermissionScope
}

type ApiKey {
    id: ID!
    name: String!
    "Leading characters of the key, for recognising it."
    prefix: String!
    createdBy: ID
    createdAt: String!
    expiresAt: String
    revokedAt: String
    permissions: [Permission!]! @goField(forceResolver: true)
}

type CreatedApiKey {
    apiKey: ApiKey!
    "The plaintext key. It is only returned here and cannot be retrieved later."
    key: String!
}

type Role {
    id: ID!
    name: String!
    permissions: [Permission!]! @goField(forceResolver: true)
}

input ApiKeyInput {
    name: String!
    "RFC3339; omit for a key that never expires."
    expiresAt: String
    permissions: [PermissionInput!]!
}

type AccessQueries {
    apiKeys: [ApiKey!]! @goField(forceResolver: true)
    roles: [Role!]! @goField(forceResolver: true)
}

type AccessMutations {
    createApiKey(input: ApiKeyInput!): CreatedApiKey! @goField(forceResolver: true)
    updateApiKey(id: ID!, input: ApiKeyInput!): ApiKey! @goField(forceResolver: true)
    revokeApiKey(id: ID!): Boolean! @goField(forceResolver: true)
    setRolePermissions(roleId: ID!, permissions: [PermissionInput!]!): Role! @goField(forceResolver: true)
}

"Which list on the media item a group is added to."
enum GroupList {
    access
    download
    earlyAccess
}

type Group {
    code: ID!
    name: String!
}

input EpisodeAccessInput {
    episodeId: ID!
    groups: [ID!]!
    "Every group is granted to (or revoked from) each of these lists."
    lists: [GroupList!]!
}

type EpisodeAccessResult {
    "Every episode that shares the media item. All of them are affected."
    episodes: [Episode!]!
    "The media item's groups after the change, for all three lists."
    roles: Roles!
}

type EpisodeAccessQueries {
    "Groups the caller may grant or revoke: the grant's allowlist, or every group if no allowlist is set."
    groups: [Group!]! @goField(forceResolver: true)
}

type EpisodeAccessMutations {
    "Adds groups to the episode's media item. Does nothing for groups already there."
    grant(input: EpisodeAccessInput!): EpisodeAccessResult! @goField(forceResolver: true) @access(resource: episodeAccess, level: write)
    "Removes groups from the episode's media item. Does nothing for groups not there."
    revoke(input: EpisodeAccessInput!): EpisodeAccessResult! @goField(forceResolver: true) @access(resource: episodeAccess, level: write)
}

type QueryRoot {
    preview: Preview! @access(resource: preview, level: read)
    statistics: Statistics! @access(resource: statistics, level: read)
    episodes: Episodes! @access(resource: episodes, level: read)
    mediaItems: MediaItems! @access(resource: mediaItems, level: read)
    search: Search! @access(resource: search, level: read)
    access: AccessQueries! @superuser
    episodeAccess: EpisodeAccessQueries! @access(resource: episodeAccess, level: read)
}

type MutationRoot {
    auth: Auth!
    access: AccessMutations! @superuser
    episodeAccess: EpisodeAccessMutations! @access(resource: episodeAccess, level: read)
}

schema{
    query: QueryRoot
    mutation: MutationRoot
}
