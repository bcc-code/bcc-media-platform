{{/* Relevance scoring shared by the public and admin search queries. */}}
{{ define "scoring" }}[
        {
          "multi_match": {
            "query": "{{ $.QueryString }}",
            "fields": [
              {{ range $index, $lang := .Languages }}
                {{ if gt $index 0}},{{ end }}
                "title_{{ $lang }}",
                "description_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": "AUTO",
            "boost": 2
          }
        },
        {
          "multi_match": {
          "query": "{{ $.QueryString }}",
          "fields": [
              "tags",
              {{ range $index, $lang := .Languages }}
                {{ if gt $index 0}},{{ end }}
                "showTitle_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": 0,
            "boost": 10
          }
        },
        {
          "multi_match": {
            "query": "{{ $.QueryString }}",
            "fields": [
              {{ range $index, $lang := .Languages }}
                {{ if gt $index 0}},{{ end }}
                "title_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": 0,
            "boost": 7
          }
        },
        {
          "multi_match": {
          "query": "{{ $.QueryString }}",
            "fields": [
              {{ range $index, $lang := .Languages }}
                {{ if gt $index 0}},{{ end }}
                "description_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": 0,
            "boost": 3
          }
        },
        {
          "multi_match": {
            "query": "{{ $.QueryString }}",
            "fields": [
              {{ range $index, $lang := .Languages }}
              {{ if gt $index 0}},{{ end }}
                "showTitle_{{ $lang }}",
                "title_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": "AUTO",
            "boost": 3
          }
        },
        {{ range $index, $lang := .Languages }}
          {{ if gt $index 0}},{{ end }}
          {
            "prefix": {
              "title_{{ $lang }}": {"value": "{{ $.QueryString }}"}
            }
          },
          {
            "prefix": {
              "description_{{ $lang }}": { "value": "{{ $.QueryString }}" }
            }
          },
          {
            "prefix": {
              "showTitle_{{ $lang }}": { "value": "{{ $.QueryString }}" }
            }
          },
          {
            "prefix": {
              "seasonTitle_{{ $lang }}": { "value": "{{ $.QueryString }}" }
            }
          }
        {{ end }}
        ,{
          "multi_match": {
            "query": "{{ $.QueryString }}",
            "fields": [
              {{ range $index, $lang := .AuxLanguages }}
                {{ if gt $index 0}},{{ end }}
                "title_{{ $lang }}",
                "description_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": "AUTO",
            "boost": 0.5
            }
          },
          {
            "multi_match": {
            "query": "{{ $.QueryString }}",
            "fields": [
              "tags",
              {{ range $index, $lang := .AuxLanguages }}
                {{ if gt $index 0}},{{ end }}
                "showTitle_{{ $lang }}"
              {{ end }}
            ],
            "fuzziness": 0,
            "boost": 0.9
          }
        }
]{{ end }}
